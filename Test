using System;
using Xunit;

public class CalculatorTests
{
    private readonly Calculator _calculator = new Calculator();

    [Fact]
    public void Add_ShouldReturnSum()
    {
        Assert.Equal(5, _calculator.Add(2, 3)); //2 + 3 = 5
    }

    [Fact]
    public void Subtract_ShouldReturnDifference()
    {
        Assert.Equal(1, _calculator.Subtract(3, 2)); //3 - 2 = 1
    }

    [Fact]
    public void Multiply_ShouldReturnProduct()
    {
        Assert.Equal(6, _calculator.Multiply(2, 3)); //3 * 2 = 6
    }

    [Fact]
    public void Divide_ShouldReturnQuotient()
    {
        Assert.Equal(2, _calculator.Divide(6, 3)); // 6 / 3 = 2
    }

    [Fact]
    public void Divide_ByZero_ShouldThrowDivideByZeroException()
    {
        Assert.Throws<DivideByZeroException>(() => _calculator.Divide(1, 0)); //деление на 0
    }

    [Fact]
    public void Power_ShouldReturnCorrectResult()
    {
        Assert.Equal(8, _calculator.Power(2, 3)); //2^3 = 8
    }
}
